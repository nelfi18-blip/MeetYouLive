{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint . --max-warnings=0",
    "test:navigation": "node --test tests/navigation-routes.test.mjs",
    "test:public-access": "node --test tests/public-access.test.mjs",
    "test:language": "node --test tests/language-detection.test.mjs",
    "test:mobile": "node --test tests/mobile-native.test.mjs",
    "start": "next start",
    "build:mobile": "next build && npx cap sync",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "android:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run cap:sync && cd android && ./gradlew assembleRelease",
    "android:aab": "npm run cap:sync && cd android && ./gradlew bundleRelease",
    "ios:sync": "npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.2",
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/camera": "^7.0.5",
    "@capacitor/core": "^7.6.2",
    "@capacitor/device": "^7.0.5",
    "@capacitor/ios": "^7.6.2",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/network": "^7.0.4",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/push-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "agora-rtc-sdk-ng": "^4.24.3",
    "firebase": "^12.12.0",
    "framer-motion": "^12.38.0",
    "next": "^15.5.21",
    "next-auth": "^4.24.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.3",
    "swiper": "^12.1.4"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.2",
    "@capacitor/cli": "^7.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "sharp": "0.35.0",
    "postcss": "8.5.23",
    "minimatch": "10.2.5",
    "brace-expansion": "5.0.8"
  }
}
