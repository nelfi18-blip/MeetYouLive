PORT=
MONGODB_URI=
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://meetyoulive.onrender.com/api/auth/google/callback
FRONTEND_URL=https://meetyoulive.net
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_SUBSCRIPTION_PRICE_ID=
# VIP tier price IDs — create separate Stripe Products for Silver, Gold, Platinum
STRIPE_VIP_SILVER_PRICE_ID=
STRIPE_VIP_GOLD_PRICE_ID=
STRIPE_VIP_PLATINUM_PRICE_ID=
# Stripe Connect — for automated creator payouts
STRIPE_CONNECT_CLIENT_ID=
# Shared server-to-server secret for /api/auth/google-session.
# Must be set to the SAME value in both Render (backend) and Vercel (frontend).
# Example: INTERNAL_API_SECRET=meetyoulive-secret
INTERNAL_API_SECRET=

# Admin seed – used by createAdminIfNotExists on server start and by npm run seed:admin
ADMIN_NAME=meetyoulive
ADMIN_EMAIL=admin@meetyoulive.net
ADMIN_PASSWORD=

# Google Play review demo creator – administrative login password used ONLY by
# scripts/set-google-play-review-accounts.js to create/reset the reusable
# demo creator counterparty account for Google Play reviewers. Never commit a
# real value here; set it as a secret in your deploy environment when running
# the script with --execute.
GOOGLE_PLAY_DEMO_CREATOR_PASSWORD=

# Google Play Billing (Android native Coins purchases) — validates purchases
# server-side via the Google Play Developer API (Android Publisher) before
# ever crediting Coins. Leave blank to keep POST /api/payments/coins/google-play
# disabled (503) without affecting Stripe web/iOS. See
# docs/GOOGLE_PLAY_BILLING_SETUP.md for how to create this service account.
# Exact application ID published to Google Play (frontend/android applicationId).
GOOGLE_PLAY_PACKAGE_NAME=com.meetyoulive.app
# Service account with Play Console "Financial data" (view) + "Orders and
# subscriptions" (manage) permissions. Create a separate key from any
# Firebase/FCM service account.
GOOGLE_PLAY_CLIENT_EMAIL=
# Paste the privateKey value from the service account JSON (\\n line endings
# are handled automatically, same convention as FCM_PRIVATE_KEY above).
GOOGLE_PLAY_PRIVATE_KEY=

# Sentry error monitoring — set to enable; leave blank to disable gracefully.
SENTRY_DSN=

# Email (SMTP) — used for verification and password-reset emails.
# Production requires SMTP_HOST, SMTP_USER and SMTP_PASS (SMTP_PORT defaults to 587).
# If SMTP values are blank, emails are logged to the console only (development mode).
# Works with any SMTP provider (Gmail, SendGrid SMTP, Mailgun SMTP, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MeetYouLive <noreply@meetyoulive.net>

# Firebase Cloud Messaging (FCM) — push notifications
# Create a service account in Firebase → Project Settings → Service Accounts
# and download the JSON key. Set the fields below from that JSON.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Paste the privateKey value from the JSON (\\n line endings are handled automatically)
FCM_PRIVATE_KEY=

# OpenAI Moderation (Phase 2 AI moderation adapter) — advisory only, never
# enforcement. Leave blank to keep the provider unconfigured (no outbound
# calls; backend behaves exactly as if no AI moderation existed).
OPENAI_API_KEY=
# Optional: override the Moderation model. Defaults to omni-moderation-latest.
OPENAI_MODERATION_MODEL=

# Photo verification ("Verificar mi foto" — Amazon Rekognition Face Liveness +
# CompareFaces against the user's persisted primary photo). PHASE 1: ships
# fully DISABLED. Do not set PHOTO_VERIFICATION_ENABLED=true until: (1) the
# AWS account below has "Allow AWS to store and use my content to develop and
# improve Rekognition" turned OFF for this account/region, (2) an S3 bucket
# lifecycle rule auto-deletes liveness session artifacts, and (3) the flow has
# been exercised on a real device (camera/Capacitor compatibility).
PHOTO_VERIFICATION_ENABLED=false
# IAM user/role restricted to rekognition:CreateFaceLivenessSession,
# rekognition:GetFaceLivenessSessionResults, rekognition:CompareFaces only.
AWS_REKOGNITION_REGION=
AWS_REKOGNITION_ACCESS_KEY_ID=
AWS_REKOGNITION_SECRET_ACCESS_KEY=
# S3 bucket used by Rekognition to stage liveness session artifacts. Must have
# a short lifecycle/expiration rule — MeetYouLive never reads selfies back out
# of it and does not persist them in the database.
AWS_REKOGNITION_LIVENESS_BUCKET=
# Decision thresholds (0-100). Defaults: similarity 90, liveness 80.
PHOTO_VERIFICATION_SIMILARITY_THRESHOLD=90
PHOTO_VERIFICATION_LIVENESS_THRESHOLD=80
# Abuse controls: session TTL, minimum time between attempts, daily attempt cap.
PHOTO_VERIFICATION_SESSION_TTL_SECONDS=600
PHOTO_VERIFICATION_MIN_RETRY_SECONDS=60
PHOTO_VERIFICATION_MAX_ATTEMPTS_PER_DAY=5
# SSRF-safe primary-photo download (backend/src/lib/secureImageFetch.js):
# only HTTPS, only an explicit allowlist of MeetYouLive's own photo storage
# hosts (Cloudinary + the app's own upload hosts are always included),
# resolved IPs are checked against private/loopback/link-local/metadata
# ranges, redirects are re-validated hop by hop and capped, and the download
# itself is time- and size-bounded.
# Comma-separated EXTRA hostnames allowed to serve a primary photo, beyond the
# built-in defaults (res.cloudinary.com, meetyoulive.net, www.meetyoulive.net).
PHOTO_VERIFICATION_ALLOWED_PHOTO_HOSTS=
# If set, also allow this backend's own public hostname (self-hosted /uploads).
BACKEND_PUBLIC_HOST=
PHOTO_VERIFICATION_MAX_IMAGE_BYTES=8388608
PHOTO_VERIFICATION_DOWNLOAD_TIMEOUT_MS=8000
PHOTO_VERIFICATION_MAX_DOWNLOAD_REDIRECTS=3

# "Perfil Auténtico" reusable face reference — SAME verification system as
# above (not a second one). After an APPROVED selfie, with SEPARATE explicit
# consent, lets a later primary-photo change be re-checked against a
# Rekognition Collection (AWS-managed face vectors; MeetYouLive itself never
# stores the selfie/image, only an encrypted opaque FaceId). Ships OFF.
FACE_REFERENCE_ENABLED=false
FACE_REFERENCE_COLLECTION_ID=meetyoulive-photo-verification
# Minimum SearchFacesByImage similarity (0-100) to reuse the badge without a
# new selfie.
FACE_REFERENCE_MATCH_THRESHOLD=92
# Limited retention: a kept reference stops being usable after this many days.
FACE_REFERENCE_RETENTION_DAYS=365
# REQUIRED to ever create/use a reference: base64-encoded 32-byte key for
# AES-256-GCM encryption of the stored opaque FaceId. Generate with e.g.
# `openssl rand -base64 32`. Leave blank to keep the feature fully inert.
FACE_REFERENCE_ENCRYPTION_KEY=
