NEXT_PUBLIC_API_URL=https://meetyoulive.onrender.com
NEXT_PUBLIC_APP_URL=https://meetyoulive.net
NEXT_PUBLIC_AGORA_APP_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://meetyoulive.net
# Shared server-to-server secret for /api/auth/google-session.
# Must be set to the SAME value in both Vercel (frontend) and Render (backend).
# Example: INTERNAL_API_SECRET=meetyoulive-secret
INTERNAL_API_SECRET=

# Firebase push notifications (FCM)
# Get these values from your Firebase project settings → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# VAPID key from Firebase → Cloud Messaging → Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Photo verification ("Verificar mi foto" — Amazon Rekognition Face Liveness).
# PHASE 1: ships fully DISABLED. Must stay "false" until the backend flag is
# also enabled AND the AWS Amplify Face Liveness capture widget has been
# verified to work inside the Capacitor native WebView (Android/iOS) — it is
# NOT assumed to work there yet. No liveness is ever simulated: when this is
# off (or unsupported on-device), the UI entry point simply does not render.
NEXT_PUBLIC_PHOTO_VERIFICATION_ENABLED=false
# AWS region for the Rekognition Face Liveness client widget.
NEXT_PUBLIC_AWS_REKOGNITION_REGION=
# Cognito Identity Pool ID granting temporary, scoped-down guest credentials
# so the browser can open the Face Liveness streaming session. Must only be
# allowed to call rekognition:StartFaceLivenessSession (no other permissions).
NEXT_PUBLIC_AWS_IDENTITY_POOL_ID=
